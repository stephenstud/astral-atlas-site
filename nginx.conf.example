# Drop-in for the site server block. Point root at this folder.
server {
    listen 80;
    server_name astralatlas.us www.astralatlas.us;
    root /var/www/astral-atlas;
    index index.html;

    location /assets/ {
        add_header Cache-Control "public, max-age=31536000, immutable";
        try_files $uri =404;
    }

    location / {
        try_files $uri $uri/ /index.html;
    }
}
